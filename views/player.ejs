<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>

    <meta property="og:site_name" content="Cine Rave">
    <meta property="og:title" content="<%= titulo %>">
    <meta property="og:image" content="<%= capa %>">
    
    <% if (isDrive) { %>
        <meta property="og:type" content="video.other">
        <meta property="og:video" content="<%= linkOriginal %>">
        <meta property="og:video:url" content="<%= linkOriginal %>">
    <% } else { %>
        <meta property="og:type" content="video.other">
        <meta property="og:video" content="<%= video %>">
        <meta property="og:video:type" content="application/x-mpegURL">
    <% } %>

    <style>
        body { margin: 0; background: #000; height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: sans-serif; }
        .btn-rave { background: #E50914; color: white; padding: 15px 30px; border-radius: 30px; text-decoration: none; font-weight: bold; font-size: 18px; margin-top: 20px; box-shadow: 0 0 20px rgba(229, 9, 20, 0.5); }
        .msg { color: #fff; text-align: center; max-width: 80%; }
        video { width: 100%; height: 60%; background: #000; margin-bottom: 20px; }
    </style>
</head>
<body>

    <h2 style="color:white"><%= titulo %></h2>

    <video controls poster="<%= capa %>">
        <source src="<%= video %>" type="<%= isDrive ? 'video/mp4' : 'application/x-mpegURL' %>">
    </video>

    <div class="msg">
        <p>Para a melhor experiência (sem travar), clique abaixo:</p>
    </div>

    <a href="<%= raveLink %>" class="btn-rave">
        <i class="fas fa-play"></i> ABRIR NO RAVE
    </a>

</body>
</html>