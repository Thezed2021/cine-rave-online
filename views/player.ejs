<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= titulo %></title>

    <meta property="og:site_name" content="Cine Rave">
    <meta property="og:url" content="<%= urlAtual %>">
    <meta property="og:title" content="<%= titulo %>">
    <meta property="og:description" content="Assista agora em HD.">
    <meta property="og:image" content="<%= capa %>">
    <meta property="og:type" content="video.movie">
    
    <meta property="og:video" content="<%= m3u8Url %>">
    <meta property="og:video:url" content="<%= m3u8Url %>">
    <meta property="og:video:secure_url" content="<%= m3u8Url %>">
    <meta property="og:video:type" content="application/x-mpegURL">
    
    <meta name="referrer" content="no-referrer">

    <style>
        body { margin: 0; background: #000; height: 100vh; display: flex; flex-direction: column; overflow: hidden; font-family: sans-serif; }
        
        .player-wrapper { flex: 1; display: flex; align-items: center; justify-content: center; position: relative; }
        
        video { width: 100%; height: 100%; max-height: 100vh; background: #000; }

        .top-bar { position: absolute; top: 0; left: 0; width: 100%; padding: 20px; z-index: 10; display: flex; gap: 10px; pointer-events: none; }
        
        .btn { pointer-events: auto; background: rgba(0,0,0,0.5); color: white; text-decoration: none; padding: 8px 15px; border-radius: 20px; border: 1px solid white; font-size: 13px; backdrop-filter: blur(4px); }
        .btn-rave { background: #E50914; border: none; font-weight: bold; }

        /* Botão de Emergência Centralizado */
        .center-msg {
            position: absolute; bottom: 80px; width: 100%; text-align: center;
            opacity: 0; transition: opacity 1s; pointer-events: none;
        }
        .btn-force {
            pointer-events: auto; background: #111; color: #00f260; 
            text-decoration: none; padding: 12px 25px; border-radius: 30px; 
            border: 1px solid #00f260; font-weight: bold; text-transform: uppercase;
            box-shadow: 0 0 20px rgba(0, 242, 96, 0.2); font-size: 12px;
        }
    </style>
</head>
<body>

    <div class="top-bar">
        <a href="/" class="btn">Voltar</a>
        <a href="<%= raveLink %>" class="btn btn-rave">Abrir no App</a>
    </div>

    <div class="player-wrapper">
        <video id="vid" controls autoplay playsinline poster="<%= capa %>">
            <source src="<%= m3u8Url %>" type="application/x-mpegURL">
            <source src="<%= video %>" type="video/mp4">
        </video>
        
        <div class="center-msg" id="msg-area">
            <a href="<%= video %>" class="btn-force">Vídeo travou? Clique para link direto</a>
        </div>
    </div>

    <script>
        // Mostra botão de ajuda se demorar
        setTimeout(() => { document.getElementById('msg-area').style.opacity = "1"; }, 4000);

        // WakeLock
        async function ativarWakeLock() {
            try { if ('wakeLock' in navigator) await navigator.wakeLock.request('screen'); } catch (e) {}
        }
        document.getElementById('vid').addEventListener('play', ativarWakeLock);
    </script>
</body>
</html>